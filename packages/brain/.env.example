# Clave gratis en https://console.groq.com
GROQ_API_KEY=

# Modelo de Groq a usar. openai/gpt-oss-120b es el mas capaz con soporte de
# tool-calling en la capa gratuita (revisa https://console.groq.com/docs/models
# porque el catalogo de Groq cambia seguido).
GROQ_MODEL=openai/gpt-oss-120b

# Ruta al JSON de la cuenta de servicio de Firebase (Project settings >
# Service accounts > Generate new private key). NO subir este archivo a git.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Como se dirige Jarvis a ti.
JARVIS_USER_NAME=Alejandro
