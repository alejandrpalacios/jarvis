# Firebase console > Configuracion del proyecto > tus apps > app Web > SDK config.
# Estos valores NO son secretos (los protegen firestore.rules), pero igual
# no se comparten fuera del proyecto.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
